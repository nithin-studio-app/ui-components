{
  "name": "@nithin22796/ui-components",
  "version": "0.2.0",
  "private": false,
  "packageManager": "pnpm@10.33.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "description": "Shared, app-agnostic React UI components for nithin-studio sub-apps.",
  "files": [
    "dist"
  ],
  "main": "./dist/ui-components.js",
  "module": "./dist/ui-components.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ui-components.js"
    },
    "./*.css": "./dist/*.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsc --noEmit && vite build && find src/foundations -name '*.css' -exec cp {} dist/ \\;",
    "build-storybook": "storybook build",
    "test": "vitest run --project=storybook",
    "test:watch": "vitest --project=storybook",
    "test:coverage": "vitest run --project=storybook --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.5",
    "globals": "^17.7.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.5.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-lib-inject-css": "^2.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0"
  }
}
